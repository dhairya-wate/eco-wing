{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/config.js",
      "destination": "/config.js"
    },
    {
      "source": "/sensor",
      "destination": "/templates/index.html"
    },
    {
      "source": "/mobile",
      "destination": "/templates/mobile.html"
    },
    {
      "source": "/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
