# EcoWing Detection System — Environment Configuration Template
# Copy this file to .env and customize values for your deployment.

# Operator authentication token for control routes (REQUIRED: minimum 32 characters)
# Protects: /api/settings, /api/upload, /api/system_info, /api/mobile/pairing_code
DETECTION_OPERATOR_TOKEN=replace-with-a-random-token-at-least-32-chars-long

# Network Binding
# By default, server binds to localhost (127.0.0.1) for security.
# Set ALLOW_LAN=true or HOST=0.0.0.0 only when LAN access is explicitly needed.
ALLOW_LAN=false
HOST=127.0.0.1
PORT=5000

# CORS Allowed Origins (comma-separated list, no wildcards when credentials enabled)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://127.0.0.1:5000

# Limits
MAX_UPLOAD_SIZE_BYTES=5242880
MAX_WS_CONNECTIONS=20
MAX_MOBILE_WS_CONNECTIONS=5

# Mobile Stream Security & Feature Flag (Disabled by default)
MOBILE_ENABLED=false
PAIRING_CODE_EXPIRY_SECONDS=300
MOBILE_SESSION_EXPIRY_SECONDS=3600

# Trusted Proxies (comma-separated list of exact IPs; default is empty)
# Proxy-forwarded IPs (X-Forwarded-For) are unsupported until verified.
# When empty, client IP is ALWAYS taken directly from the peer socket.
DETECTION_TRUSTED_PROXIES=

# Set to 1 only if explicitly authorizing start_tunnel.bat to expose local port to public internet
ALLOW_TUNNEL=0


