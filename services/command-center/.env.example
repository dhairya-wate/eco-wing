PORT=3000

# MongoDB Connection Configuration (REQUIRED with no default in Docker Compose):
# For local Docker stack, provide root credentials:
MONGO_INITDB_ROOT_USERNAME=ecowing_admin
MONGO_INITDB_ROOT_PASSWORD=replace-with-a-secure-database-password
MONGO_URI=mongodb://ecowing_admin:replace-with-a-secure-database-password@mongodb:27017/ecowing?authSource=admin

# Security: Operator Authentication (REQUIRED: at least 32 characters, 12 distinct characters)
# Token required in 'X-Operator-Token' header for drone control, command, and purge/export endpoints
ECOWING_OPERATOR_TOKEN=replace-with-a-random-token-at-least-32-chars-long

# Security: Drone Device Tokens for Telemetry and Ingestion Auth (E2)
# Configured via environment variables only. Supports JSON map or comma-separated pairs:
# Format A: JSON map: '{"Drone-01":"tokenA_at_least_32_chars","Drone-02":"tokenB_at_least_32_chars"}'
# Format B: Comma-separated: 'Drone-01:tokenA,Drone-02:tokenB'
# Format C: Per-drone env var: DRONE_TOKEN_DRONE_01=tokenA
DRONE_DEVICE_TOKENS={"Drone-01":"drone_secret_token_alpha_1234567890"}

# Target Address Allowlist for Drone Connections
# Comma-separated list of approved hostnames or IP addresses allowed for drone registration and stream relay.
# Default is empty (strict deny-all). Explicitly configure trusted drone hostnames or IPs.
# Any address or stream URL not matching this allowlist is rejected with HTTP 400.
DRONE_TARGET_ALLOWLIST=

# Security: CORS Origin Allowlist (E-NEW1)
# Comma-separated list of browser origins permitted to connect to Express API and Socket.IO.
# Defaults if unset: http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Reliability: Telemetry Data Retention TTL (E8)
# Telemetry documents automatically expire and delete after this duration (in seconds).
# Default: 604800 seconds (7 days)
TELEMETRY_TTL_SECONDS=604800
# Reliability: Ingestion Rate Limiting & Body Protection (E7)
# Sliding window (ms) and max permitted requests per client/drone.
INGESTION_RATE_LIMIT_WINDOW_MS=60000
INGESTION_RATE_LIMIT_MAX=180
# Security: Trusted Proxies Topology (OP-3)
# Comma-separated list of exact IP addresses of trusted reverse proxies (e.g. Nginx).
# Default: empty (untrusted; X-Forwarded-For is ignored to prevent IP spoofing).
ECOWING_TRUSTED_PROXIES=
