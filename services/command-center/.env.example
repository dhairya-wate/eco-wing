# EcoWing Fleet Command Center — Environment Configuration
# Copy this file to backend/.env or use with docker-compose.yml

# Operator Authentication (Mandatory: high-entropy secret, min 32 chars, not repetitive)
ECOWING_OPERATOR_TOKEN=change_me_to_a_secure_operator_token_at_least_32_chars_long_12345

# Trusted Reverse Proxy IPs (Comma-separated exact IPs, default empty disables X-Forwarded-For trust)
# For Docker network gateway or Nginx proxy: e.g. 172.28.0.2, 127.0.0.1
ECOWING_TRUSTED_PROXIES=

# Drone Device Tokens (JSON map: drone_id -> token)
DRONE_DEVICE_TOKENS={"Drone-01": "secure_drone_01_token_at_least_32_characters_long_12345", "Drone-02": "secure_drone_02_token_at_least_32_characters_long_12345"}

# Target IP / Hostname Allowlist for Drone Network Streams (Anti-SSRF & DNS rebinding guard, comma-separated)
DRONE_TARGET_ALLOWLIST=127.0.0.1,localhost

# MongoDB Connection String (Mandatory: must include user credentials)
MONGO_URI=mongodb://ecowing_admin:ecowing_secure_password_123@mongodb:27017/ecowing?authSource=admin

# Server Port (Default: 3000)
PORT=3000

# CORS Allowed Origins (Comma-separated exact origins, no wildcards)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080

# Ingestion Rate Limiter Configuration (Sliding window)
INGEST_RATE_LIMIT_WINDOW_MS=60000
INGEST_RATE_LIMIT_MAX_REQUESTS=120

# Telemetry TTL Retention (in seconds, default: 604800 = 7 days)
TELEMETRY_TTL_SECONDS=604800
