{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/config.js",
      "destination": "/config.js"
    },
    {
      "source": "/video_feed",
      "destination": "https://ecowing-detection-system.onrender.com/video_feed"
    },
    {
      "source": "/api/detections",
      "destination": "https://ecowing-detection-system.onrender.com/api/detections"
    },
    {
      "source": "/sensor",
      "destination": "/services/sensor/templates/index.html"
    },
    {
      "source": "/mobile",
      "destination": "/services/sensor/templates/mobile.html"
    },
    {
      "source": "/static/(.*)",
      "destination": "/services/sensor/static/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
